{
  "name": "hafen-imperium",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build && node scripts/pwa.mjs",
    "build:single": "npm run build && node scripts/inline.mjs",
    "preview": "vite preview --host",
    "test": "vitest run",
    "playtest": "PLAYTEST=1 vitest run tests/playtest.test.ts --disableConsoleIntercept"
  },
  "dependencies": {
    "@fontsource/baloo-2": "^5.3.0",
    "@fontsource/nunito": "^5.3.0",
    "pixi.js": "^8.23.0"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
